<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Preconsulta_MI" targetNamespace="https://valarsalud.co/preconsulta-mi" name="Preconsulta y priorización Medicina Interna">
<bpmn:process id="Proceso_Preconsulta_Priorizacion_MI" name="Preconsulta y mecanismo de priorización — Medicina Interna (Valar Salud / Colsubsidio)" isExecutable="false">
<bpmn:startEvent id="A0" name="Solicitud/cita MI registrada"><bpmn:documentation>MÉTODO DE ANÁLISIS: Captura del evento y fuente de solicitud.
CRITERIO DE DECISIÓN: Paciente, fecha solicitud/remisión, tipo y cita disponibles.
ALTERNATIVAS: Si falta dato: corregir fuente; no inferir.
EVIDENCIA: MGTE operativo
NORMA: Res. 2117/2025; Circular 038/2025; Res. 1552/2013
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:startEvent>
<bpmn:task id="A1" name="Crear episodio e ID único"><bpmn:documentation>MÉTODO DE ANÁLISIS: Regla determinística documento + cita + fecha.
CRITERIO DE DECISIÓN: Un episodio por solicitud; duplicados se identifican.
ALTERNATIVAS: Revisión administrativa; nunca borrar solicitud.
EVIDENCIA: Trazabilidad MGTE
NORMA: Res. 2117/2025
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="A2" name="Calcular antigüedad y oportunidad"><bpmn:documentation>MÉTODO DE ANÁLISIS: Días calendario solicitud→asignación y atención.
CRITERIO DE DECISIÓN: Antigüedad compone prioridad con criterio clínico.
ALTERNATIVAS: Dato faltante se marca; no excluye.
EVIDENCIA: Circular 038: meta MI &lt;15 días
NORMA: Res. 2117/2025; Circular 038/2025
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="A3" name="Contactar 72–96 h antes (bot)"><bpmn:documentation>MÉTODO DE ANÁLISIS: Teleorientación y captura estructurada por canal digital.
CRITERIO DE DECISIÓN: Paciente de cohorte con cita identificada.
ALTERNATIVAS: Prefiere llamada/no responde→cola; no desea→cita intacta.
EVIDENCIA: E7 solo evidencia operativa
NORMA: Res. 2654/2019 arts. 4,7,9–12
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="A4" name="Consentimiento y libre escogencia"><bpmn:documentation>MÉTODO DE ANÁLISIS: Aceptación digital con versión, fecha y trazabilidad.
CRITERIO DE DECISIÓN: Sin aceptación no se capturan datos clínicos.
ALTERNATIVAS: Llamada humana o no participar; cita intacta.
EVIDENCIA: Consentimiento informado digital
NORMA: Res. 2654/2019 art.7; Ley 1581/2012; Ley 527/1999
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:exclusiveGateway id="G1" name="¿Acepta y responde?" gatewayDirection="Diverging"><bpmn:documentation>MÉTODO DE ANÁLISIS: Evaluación de autorización y canal.
CRITERIO DE DECISIÓN: Sí→identidad; prefiere llamada/no responde→cola; no→mantener cita.
ALTERNATIVAS: Toda salida preserva el acceso.
EVIDENCIA: E7; humanización
NORMA: Res. 2654/2019 arts.4,12.1; Res. 1315/2026
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:exclusiveGateway>
<bpmn:task id="A5" name="Cola de llamadas + intentos"><bpmn:documentation>MÉTODO DE ANÁLISIS: Regla operativa con intentos, franja y resultado.
CRITERIO DE DECISIÓN: Hasta 2 intentos en franjas distintas (gobernanza del piloto).
ALTERNATIVAS: Si no contacta: mantener cita original.
EVIDENCIA: Canal de respaldo; umbral operativo, no clínico
NORMA: Res. 2654/2019 arts.6 par.,9–10
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="A5b" name="Preconsulta telefónica PRE-TEL-01"><bpmn:documentation>MÉTODO DE ANÁLISIS: Mismo árbol, agente supervisado; sin juicio clínico.
CRITERIO DE DECISIÓN: Contacto efectivo, consentimiento e identidad verificados.
ALTERNATIVAS: Bandera/duda→supervisor; falla identidad→cita intacta.
EVIDENCIA: E5/E6 justifican supervisión
NORMA: Res. 2654/2019 arts.6 par.,9–12
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="A7" name="Mantener cita original sin cambios"><bpmn:documentation>MÉTODO DE ANÁLISIS: Regla de libre escogencia/no denegación.
CRITERIO DE DECISIÓN: Rechazo, identidad fallida o contacto imposible.
ALTERNATIVAS: No hay captura ni cambio de ruta.
EVIDENCIA: No denegación
NORMA: Res. 1552/2013 art.1; Res. 2654/2019 art.4
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="A6" name="Verificar identidad"><bpmn:documentation>MÉTODO DE ANÁLISIS: Últimos 4 dígitos + fecha nacimiento u OTP.
CRITERIO DE DECISIÓN: Coincidencia con registro de cita.
ALTERNATIVAS: Si falla: sin datos clínicos; ofrecer llamada; cita intacta.
EVIDENCIA: Identificación segura
NORMA: Res. 2654/2019 art.12.3; Res. 3100/2019
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:exclusiveGateway id="G2" name="¿Identidad confirmada?" gatewayDirection="Diverging"><bpmn:documentation>MÉTODO DE ANÁLISIS: Comparación de factores de identidad.
CRITERIO DE DECISIÓN: Sí→banderas rojas; no→mantener cita sin datos.
ALTERNATIVAS: No se continúa con información clínica si falla.
EVIDENCIA: Seguridad del paciente
NORMA: Res. 2654/2019 art.12.3
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:exclusiveGateway>
<bpmn:task id="B1" name="Pantalla de banderas rojas"><bpmn:documentation>MÉTODO DE ANÁLISIS: Lista determinística conservadora antes del motivo.
CRITERIO DE DECISIÓN: Cualquier positivo→RX; no sabe/no comprende→humano.
ALTERNATIVAS: Nunca descarte autónomo ni diagnóstico.
EVIDENCIA: E5/E6: exactitud variable; supervisión obligatoria
NORMA: Res. 2654/2019 art.27
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:exclusiveGateway id="G3" name="¿Bandera roja?" gatewayDirection="Diverging"><bpmn:documentation>MÉTODO DE ANÁLISIS: Regla de seguridad de máxima prioridad.
CRITERIO DE DECISIÓN: Sí→urgencias y alerta; no→entrevista estructurada.
ALTERNATIVAS: Si duda: escalamiento humano.
EVIDENCIA: E5/E6
NORMA: Res. 2654/2019 art.27
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:exclusiveGateway>
<bpmn:task id="RX" name="Urgencias + alerta &lt;15 min; proteger cita"><bpmn:documentation>MÉTODO DE ANÁLISIS: Escalamiento inmediato al supervisor y reprogramación protegida.
CRITERIO DE DECISIÓN: Bandera roja positiva.
ALTERNATIVAS: Contacto humano confirma; no se cierra solicitud por inasistencia.
EVIDENCIA: Seguridad; prioridad máxima MGTE
NORMA: Res. 2654/2019 art.27; Res. 2117/2025
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:endEvent id="E2" name="Cierre con alerta resuelta"><bpmn:documentation>MÉTODO DE ANÁLISIS: Registro de contacto, conducta y seguimiento.
CRITERIO DE DECISIÓN: Supervisor documenta gestión y reprogramación.
ALTERNATIVAS: Si no contacta: llamada prioritaria y preservación de atención.
EVIDENCIA: Trazabilidad de seguridad
NORMA: Res. 2654/2019 art.27
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:endEvent>
<bpmn:task id="B2" name="Entrevista estructurada P2–P7"><bpmn:documentation>MÉTODO DE ANÁLISIS: Tipo, motivo, objetivo, síntomas nuevos, paráclínicos, medicamentos.
CRITERIO DE DECISIÓN: Recolectar necesidad y contexto; no diagnosticar.
ALTERNATIVAS: Ambigüedad/incoherencia→aclaración humana.
EVIDENCIA: E7: evaluación de servicio, no eficacia clínica
NORMA: Res. 2654/2019 arts.9–10
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="B3" name="Generar resumen estructurado"><bpmn:documentation>MÉTODO DE ANÁLISIS: Plantilla versionada sin inferencias no presentes.
CRITERIO DE DECISIÓN: Solo se consolida lo respondido.
ALTERNATIVAS: Campo obligatorio faltante→incompleto.
EVIDENCIA: Registro clínico estructurado
NORMA: Res. 2654/2019 art.10; Res. 1995/1999; Ley 2015/2020
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="B4" name="Validar suficiencia y consistencia"><bpmn:documentation>MÉTODO DE ANÁLISIS: Completitud + reglas simples de coherencia.
CRITERIO DE DECISIÓN: Suficiente y sin contradicciones para revisión.
ALTERNATIVAS: Si no: teléfono o profesional; no ruta automática.
EVIDENCIA: E5/E6 exigen control humano
NORMA: Res. 2654/2019 arts.5,27
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:exclusiveGateway id="G4" name="¿Información suficiente?" gatewayDirection="Diverging"><bpmn:documentation>MÉTODO DE ANÁLISIS: Completitud y consistencia del registro.
CRITERIO DE DECISIÓN: Sí→revisión clínica; no→escalar/contactar.
ALTERNATIVAS: Sin información no se asigna ruta.
EVIDENCIA: E5/E6
NORMA: Res. 2654/2019 arts.5,27
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:exclusiveGateway>
<bpmn:task id="B4x" name="Escalar a profesional / contacto telefónico"><bpmn:documentation>MÉTODO DE ANÁLISIS: Completar o aclarar con humano supervisado.
CRITERIO DE DECISIÓN: Respuesta faltante, ambigua o inconsistente.
ALTERNATIVAS: Si persiste duda: presencial MI.
EVIDENCIA: Seguridad y autonomía profesional
NORMA: Res. 2654/2019 arts.5,6 par.
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="B5" name="Revisión clínica y priorización"><bpmn:documentation>MÉTODO DE ANÁLISIS: Profesional aplica nivel clínico + antigüedad; sistema solo propone.
CRITERIO DE DECISIÓN: Emergente/urgente/semi-urgente/no urgente; documentar razón.
ALTERNATIVAS: Ante duda: presencial MI; ninguna rama sin médico.
EVIDENCIA: Mecanismo explícito MGTE
NORMA: Res. 2117/2025; Res. 2654/2019 art.5; Ley 1751/2015 art.17
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="B6" name="Elegibilidad para telemedicina"><bpmn:documentation>MÉTODO DE ANÁLISIS: Juicio profesional + conectividad + aceptación.
CRITERIO DE DECISIÓN: Solo si valoración a distancia es segura y útil.
ALTERNATIVAS: Si no: Ruta A o C; nunca forzar canal.
EVIDENCIA: E1: 93 ECA, N=22.047; depende del contexto
NORMA: Res. 2654/2019 arts.13–16; Res. 3100/2019
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:exclusiveGateway id="G5" name="¿Ruta A, B o C?" gatewayDirection="Diverging"><bpmn:documentation>MÉTODO DE ANÁLISIS: Prioridad clínica + antigüedad + elegibilidad + elección.
CRITERIO DE DECISIÓN: A: urgente/compleja; B: semi-urgente elegible; C: no urgente/programable.
ALTERNATIVAS: Ante duda: A presencial; solicitud MI siempre abierta.
EVIDENCIA: E1/E2/E3/E4/E8; Circular 038 meta &lt;15 días
NORMA: Res. 2117/2025; Res. 1552/2013; Res. 2654/2019
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:exclusiveGateway>
<bpmn:task id="C1" name="RUTA A: presencial MI ≤15 días"><bpmn:documentation>MÉTODO DE ANÁLISIS: Asignación prioritaria + PRE-MI-01.
CRITERIO DE DECISIÓN: Urgente/emergente no diferible, complejidad o descompensación.
ALTERNATIVAS: Si médico y paciente lo deciden: B; si requiere preparación: C.
EVIDENCIA: E1 no prueba selección; meta operativa
NORMA: Circular 038/2025; Res. 2117/2025
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="C2" name="RUTA B: telemedicina MI ≤15 días"><bpmn:documentation>MÉTODO DE ANÁLISIS: Teleconsulta habilitada + consentimiento.
CRITERIO DE DECISIÓN: Semi-urgente elegible y paciente acepta.
ALTERNATIVAS: Falla técnica/clínica→A; preparación pendiente→C.
EVIDENCIA: E1: resultados comparables en contextos seleccionados
NORMA: Res. 2654/2019 arts.13–16; Res. 3100/2019
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="C3" name="RUTA C: programa por partes"><bpmn:documentation>MÉTODO DE ANÁLISIS: Paráclínicos→integración→MG/telexperticia→MI si procede.
CRITERIO DE DECISIÓN: No urgente/rutinario, crónico estable o resoluble en etapas.
ALTERNATIVAS: Nuevos criterios→A/B; solicitud MI permanece abierta.
EVIDENCIA: E2/E3/E4/E8; E4 exige selección (&lt;10% en algunos servicios)
NORMA: Res. 2654/2019 arts.11,17; Res. 2626/2019
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="C4" name="Comunicar ruta, criterio y fecha"><bpmn:documentation>MÉTODO DE ANÁLISIS: Mensaje claro + entregable al profesional.
CRITERIO DE DECISIÓN: Paciente conoce por qué y cuándo será atendido.
ALTERNATIVAS: MANTENER→conservar cita MI; sin cambios automáticos.
EVIDENCIA: Libre escogencia y resumen al usuario
NORMA: Res. 2654/2019 arts.4,10; Res. 1315/2026
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:exclusiveGateway id="G6" name="¿Paciente acepta la ruta?" gatewayDirection="Diverging"><bpmn:documentation>MÉTODO DE ANÁLISIS: Elección informada del paciente.
CRITERIO DE DECISIÓN: Sí→ejecutar; no/MANTENER→cita MI original.
ALTERNATIVAS: No hay cambio de ruta sin aceptación o indicación médica.
EVIDENCIA: Libre escogencia
NORMA: Res. 2654/2019 art.4
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:exclusiveGateway>
<bpmn:task id="C6" name="Mantener cita MI original / presencial"><bpmn:documentation>MÉTODO DE ANÁLISIS: Conservar atención por libre escogencia o duda.
CRITERIO DE DECISIÓN: Paciente no acepta ruta o revisor lo decide.
ALTERNATIVAS: No se cierra solicitud; registrar decisión.
EVIDENCIA: No denegación
NORMA: Res. 1552/2013 art.1; Res. 2654/2019 art.4
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="C5" name="Ejecutar atención y registrar en HC"><bpmn:documentation>MÉTODO DE ANÁLISIS: Atención efectiva + documentos soporte por ID.
CRITERIO DE DECISIÓN: Atención prestada y trazada.
ALTERNATIVAS: Inasistencia→reprogramar por prioridad, no cerrar solicitud.
EVIDENCIA: Registro clínico
NORMA: Res. 2654/2019 art.13 par.2; Res. 1995/1999
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="D1" name="Actualizar dashboard e indicadores"><bpmn:documentation>MÉTODO DE ANÁLISIS: Contacto, prioridad, ruta, tiempos, satisfacción por ID.
CRITERIO DE DECISIÓN: Datos completos y trazables.
ALTERNATIVAS: Dato faltante se marca; no se imputa.
EVIDENCIA: Analítica y MGTE
NORMA: Res. 001058/2026; Res. 2117/2025
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="D2" name="Auditoría de seguridad y concordancia"><bpmn:documentation>MÉTODO DE ANÁLISIS: 100% RX + muestra semanal C + eventos; regla–médico.
CRITERIO DE DECISIÓN: Gobernanza: concordancia ≥85%; 0 eventos atribuibles.
ALTERNATIVAS: Si falla: pausar sugerencias, revisar árbol y reentrenar.
EVIDENCIA: E2/E5/E6; umbral de gobernanza, no clínico
NORMA: Res. 2654/2019 art.27; CONPES 4144/2025
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:task id="D3" name="Cierre, seguimiento y recalibración"><bpmn:documentation>MÉTODO DE ANÁLISIS: Antes/después + RE-AIM; desenlaces 7/30 días.
CRITERIO DE DECISIÓN: Oportunidad, seguridad, satisfacción y resolución.
ALTERNATIVAS: Si evidencia insuficiente: no escalar; rediseñar.
EVIDENCIA: E8 RE-AIM; mejora continua
NORMA: Res. 001058/2026
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:task>
<bpmn:endEvent id="E9" name="Episodio cerrado con trazabilidad"><bpmn:documentation>MÉTODO DE ANÁLISIS: Cierre con decisión, atención y seguimiento documentados.
CRITERIO DE DECISIÓN: No hay solicitudes sin resolución ni registro.
ALTERNATIVAS: Reabrir si nueva necesidad o criterio clínico.
EVIDENCIA: No denegación y continuidad
NORMA: Res. 1552/2013; Res. 2117/2025
ESPECIFICACIÓN COMPLETA: ANEXO_10_FLUJO_BPMN_PRIORIZACION.md</bpmn:documentation></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_01" name="" sourceRef="A0" targetRef="A1"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_02" name="" sourceRef="A1" targetRef="A2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_03" name="" sourceRef="A2" targetRef="A3"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_04" name="" sourceRef="A3" targetRef="A4"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_05" name="" sourceRef="A4" targetRef="G1"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_06" name="Sí, acepta y responde" sourceRef="G1" targetRef="A6"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sí, acepta y responde</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_07" name="Prefiere llamada / no responde" sourceRef="G1" targetRef="A5"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Prefiere llamada / no responde</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_08" name="No desea participar" sourceRef="G1" targetRef="A7"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No desea participar</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_09" name="" sourceRef="A5" targetRef="A5b"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_10" name="Identidad y consentimiento telefónicos" sourceRef="A5b" targetRef="A6"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Identidad y consentimiento telefónicos</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_11" name="" sourceRef="A6" targetRef="G2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_12" name="Sí" sourceRef="G2" targetRef="B1"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_13" name="No / falla verificación" sourceRef="G2" targetRef="A7"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No / falla verificación</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_14" name="" sourceRef="B1" targetRef="G3"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_15" name="Sí" sourceRef="G3" targetRef="RX"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_16" name="No" sourceRef="G3" targetRef="B2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_17" name="" sourceRef="RX" targetRef="E2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_18" name="" sourceRef="B2" targetRef="B3"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_19" name="" sourceRef="B3" targetRef="B4"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="Flow_20" name="" sourceRef="B4" targetRef="G4"></bpmn:sequenceFlow>
